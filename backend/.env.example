# ==============================================================
# CẤU HÌNH HỆ THỐNG NỘI THẤT GÓC NHÀ ĐẸP (.env.example)
# ==============================================================

# Cổng chạy backend server
PORT=8080

# Chế độ Gin: debug (khi lập trình) hoặc release (khi chạy production)
GIN_MODE=debug

# Đường dẫn URL web người dùng (Storefront)
STOREFRONT_URL=http://localhost:4321

# Kết nối cơ sở dữ liệu MySQL (XAMPP mặc định: root, không mật khẩu, cổng 3306)
DB_DSN=root:@tcp(127.0.0.1:3306)/furniture_shop?charset=utf8mb4&parseTime=True&loc=Local

# Khóa bí mật JWT ký phiên đăng nhập (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRE_HOURS=24

# Cấu hình tải ảnh lên hệ thống
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ==============================================================
# 1. CẤU HÌNH GỬI EMAIL THÔNG BÁO TỰ ĐỘNG (GMAIL SMTP HOÀN TOÀN MIỄN PHÍ)
# ==============================================================
# Máy chủ SMTP của Google
SMTP_HOST=smtp.gmail.com
# Cổng kết nối SMTP: 587 (STARTTLS) hoặc 465 (SSL)
SMTP_PORT=587
# Địa chỉ Gmail của shop (ví dụ: gocnhadep.official@gmail.com)
SMTP_USERNAME=your_gmail@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Google (Gmail App Password)
# Lưu ý: Đây KHÔNG PHẢI mật khẩu đăng nhập Gmail thông thường.
# Cách tạo: Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Địa chỉ email hiển thị người gửi
SMTP_FROM_EMAIL=your_gmail@gmail.com
# Tên thương hiệu hiển thị trong hộp thư đến của khách hàng
SMTP_FROM_NAME=Nội Thất Góc Nhà Đẹp

# ==============================================================
# 2. CẤU HÌNH THANH TOÁN TỰ ĐỘNG SEPAY (my.sepay.vn)
# ==============================================================
# API Key / Webhook secret từ SePay Dashboard (dùng bảo vệ endpoint Webhook)
SEPAY_API_KEY=your_sepay_api_key_here

# ==============================================================
# 3. CẤU HÌNH ĐĂNG NHẬP GOOGLE OAUTH2
# ==============================================================
# Lấy từ Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================
# 4. CẤU HÌNH THÔNG BÁO CHO CHỦ SHOP QUA TELEGRAM BOT (TÙY CHỌN)
# ==============================================================
# Tạo Bot tại @BotFather trên Telegram để nhận Token
TELEGRAM_BOT_TOKEN=
# Lấy Chat ID của bạn tại @userinfobot trên Telegram
TELEGRAM_CHAT_ID=
