---
import type { Category } from '../../types';
import { imgUrl } from '../../lib/format';

export interface Props {
  categories?: Category[];
}

const { categories: rawCategories = [] } = Astro.props;

// Ảnh dự phòng chuẩn nội thất sắc nét và ổn định nếu Admin chưa tải ảnh
function getCategoryFallbackImage(name: string): string {
  const lower = name.toLowerCase();
  if (lower.includes('sofa')) {
    return 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('ghế') || lower.includes('ghe')) {
    return 'https://images.unsplash.com/photo-1503602642458-232111445657?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('bàn') || lower.includes('ban')) {
    return 'https://images.unsplash.com/photo-1617806118233-18e1de247200?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('giường') || lower.includes('giuong')) {
    return 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('tủ') || lower.includes('kệ') || lower.includes('tu') || lower.includes('ke')) {
    return 'https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('đèn') || lower.includes('den')) {
    return 'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=600&auto=format&fit=crop&q=80';
  }
  if (lower.includes('trang trí') || lower.includes('decor')) {
    return 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?w=600&auto=format&fit=crop&q=80';
  }
  return 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&auto=format&fit=crop&q=80';
}

// Xây dựng danh sách danh mục hiển thị từ Database và gộp "Tủ" + "Kệ"
let displayCategories: Array<{ name: string; href: string; image: string }> = [];

if (rawCategories.length > 0) {
  const rootCats = rawCategories.filter((c) => !c.parent_id);
  const sourceList = rootCats.length > 0 ? rootCats : rawCategories;

  let addedTuKe = false;

  sourceList.forEach((c) => {
    const lower = c.name.toLowerCase().trim();
    if (
      lower === 'tủ' ||
      lower === 'kệ' ||
      lower === 'tu' ||
      lower === 'ke' ||
      (lower.includes('tủ') && lower.includes('kệ')) ||
      lower === 'tủ & kệ' ||
      lower === 'tủ kệ'
    ) {
      if (!addedTuKe) {
        displayCategories.push({
          name: 'Tủ & Kệ',
          href: '/products?category=tu-ke',
          image: c.image ? imgUrl(c.image) : getCategoryFallbackImage('Tủ & Kệ'),
        });
        addedTuKe = true;
      }
    } else {
      displayCategories.push({
        name: c.name,
        href: `/products?category=${c.slug || c.id}`,
        image: c.image ? imgUrl(c.image) : getCategoryFallbackImage(c.name),
      });
    }
  });
}

// Nếu danh mục chưa có thì hiển thị bộ danh mục mặc định chuẩn đẹp
if (displayCategories.length === 0) {
  displayCategories = [
    { name: 'Sofa', href: '/products?category=sofa', image: getCategoryFallbackImage('sofa') },
    { name: 'Bàn ăn', href: '/products?category=ban-an', image: getCategoryFallbackImage('bàn ăn') },
    { name: 'Ghế', href: '/products?category=ghe', image: getCategoryFallbackImage('ghế') },
    { name: 'Giường', href: '/products?category=giuong', image: getCategoryFallbackImage('giường') },
    { name: 'Tủ & Kệ', href: '/products?category=tu-ke', image: getCategoryFallbackImage('Tủ & Kệ') },
    { name: 'Đèn', href: '/products?category=den', image: getCategoryFallbackImage('đèn') },
    { name: 'Đồ trang trí', href: '/products?category=trang-tri', image: getCategoryFallbackImage('trang trí') },
  ];
}
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 font-sans">
  <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4">
    {displayCategories.map((c) => (
      <a
        href={c.href}
        class="group relative h-48 sm:h-56 rounded-2xl overflow-hidden shadow-soft hover:shadow-elevated transition-all duration-300 block bg-warm-100"
      >
        <!-- Background Image -->
        <img
          src={c.image}
          alt={c.name}
          class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500"
          loading="lazy"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&auto=format&fit=crop&q=80';"
        />

        <!-- Subtle Dark Tint for Text Readability -->
        <div class="absolute inset-0 bg-black/25 group-hover:bg-black/40 transition-colors"></div>

        <!-- Center Name -->
        <div class="absolute inset-0 flex items-center justify-center p-2 text-center">
          <span class="font-bold text-base sm:text-lg text-white tracking-wide drop-shadow-md group-hover:scale-105 transition-transform">
            {c.name}
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
