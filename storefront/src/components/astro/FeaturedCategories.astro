---
import type { Category } from '../../types';
import { imgUrl } from '../../lib/format';

export interface Props {
  categories?: Category[];
}

const { categories: rawCategories = [] } = Astro.props;

// Ảnh dự phòng chuẩn phong cách nội thất tinh tế cao cấp theo Figma (Ảnh 2 & 3)
function getCategoryFallbackImage(name: string): string {
  const lower = name.toLowerCase();
  if (lower.includes('sofa')) {
    return 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('ghế') || lower.includes('ghe')) {
    return 'https://images.unsplash.com/photo-1580481077195-c328a37db71a?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('bàn') || lower.includes('ban') || lower.includes('tủ') || lower.includes('kệ')) {
    return 'https://images.unsplash.com/photo-1533090161767-e6ffed986c88?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('giường') || lower.includes('giuong')) {
    return 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('ngoài trời') || lower.includes('ngoai troi')) {
    return 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('văn phòng') || lower.includes('van phong')) {
    return 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('trang trí') || lower.includes('decor')) {
    return 'https://images.unsplash.com/photo-1616046229478-9901c5536a45?w=600&auto=format&fit=crop&q=85';
  }
  if (lower.includes('đèn') || lower.includes('den')) {
    return 'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=600&auto=format&fit=crop&q=85';
  }
  return 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&auto=format&fit=crop&q=85';
}

// Xây dựng danh sách danh mục hiển thị từ Database hoặc theo chuẩn 7 mục Figma
let displayCategories: Array<{ name: string; href: string; image: string }> = [];

if (rawCategories.length > 0) {
  const rootCats = rawCategories.filter((c) => !c.parent_id);
  const sourceList = rootCats.length > 0 ? rootCats : rawCategories;

  let addedTuKe = false;

  sourceList.forEach((c) => {
    const lower = c.name.toLowerCase().trim();

    // Bỏ qua hoàn toàn danh mục "Nội thất khác" theo yêu cầu người dùng
    if (
      lower.includes('khác') ||
      lower.includes('khac') ||
      c.slug === 'noi-that-khac' ||
      c.id === 9
    ) {
      return;
    }

    if (
      lower === 'tủ' ||
      lower === 'kệ' ||
      lower === 'tu' ||
      lower === 'ke' ||
      (lower.includes('tủ') && lower.includes('kệ')) ||
      lower === 'tủ & kệ' ||
      lower === 'tủ kệ' ||
      lower === 'bàn & tủ'
    ) {
      if (!addedTuKe) {
        displayCategories.push({
          name: 'Bàn & Tủ',
          href: '/products?category=tu-ke',
          image: c.image ? imgUrl(c.image) : getCategoryFallbackImage('Bàn & Tủ'),
        });
        addedTuKe = true;
      }
    } else {
      displayCategories.push({
        name: c.name,
        href: `/products?category=${c.slug || c.id}`,
        image: c.image ? imgUrl(c.image) : getCategoryFallbackImage(c.name),
      });
    }
  });

  // Giữ chính xác 7 danh mục theo chuẩn thiết kế Figma
  displayCategories = displayCategories.slice(0, 7);
}

// Nếu danh mục chưa có thì hiển thị chuẩn 7 mục theo đúng Figma Ảnh 2 & 3
if (displayCategories.length === 0) {
  displayCategories = [
    { name: 'Sofa', href: '/products?category=sofa', image: getCategoryFallbackImage('sofa') },
    { name: 'Ghế', href: '/products?category=ghe', image: getCategoryFallbackImage('ghế') },
    { name: 'Bàn & Tủ', href: '/products?category=ban-an', image: getCategoryFallbackImage('bàn & tủ') },
    { name: 'Giường', href: '/products?category=giuong', image: getCategoryFallbackImage('giường') },
    { name: 'Ngoài trời', href: '/products?category=ngoai-troi', image: getCategoryFallbackImage('ngoài trời') },
    { name: 'Văn phòng', href: '/products?category=van-phong', image: getCategoryFallbackImage('văn phòng') },
    { name: 'Trang trí', href: '/products?category=trang-tri', image: getCategoryFallbackImage('trang trí') },
  ];
}
---

<!-- 
  Frame 1000003337: Container thẻ danh mục theo Figma Ảnh 2:
  - Width: Hug (1,278px), Height: Fixed (255px), Flow: Horizontal, Gap: 8px
  - Scroll overflow: Horizontal, Scroll position: Scroll with parent
-->
<section class="w-full font-sans flex justify-center py-0">
  <div
    class="w-full max-w-[1278px] h-[255px] flex flex-row items-center gap-[8px] overflow-x-auto scrollbar-none box-border justify-start min-[1440px]:justify-center py-0"
    style="opacity: 1; justify-content: safe center;"
  >
    {displayCategories.map((c) => (
      <!-- 
        Mỗi thẻ danh mục theo Figma Ảnh 3:
        - Width: Fixed (175.71px), Height: Fixed (255px), Flow: Vertical
        - Radius: 8px, Padding: 24px, Gap: 16px, Colors: #000000 20%
      -->
      <a
        href={c.href}
        class="group relative w-[175.71px] min-w-[175.71px] h-[255px] shrink-0 rounded-[8px] overflow-hidden p-[24px] flex flex-col items-center justify-start gap-[16px] transition-all duration-300 hover:shadow-lg hover:scale-[1.02] box-border select-none"
        style="opacity: 1;"
      >
        <!-- Background Image -->
        <img
          src={c.image}
          alt={c.name}
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&auto=format&fit=crop&q=85';"
        />

        <!-- Figma #000000 20% Fill Layer -->
        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/30 transition-colors"></div>

        <!-- Category Title (Flow: Vertical, Padding: 24px, Gap: 16px) -->
        <span
          class="relative z-10 text-white font-bold text-center tracking-wide drop-shadow-md text-[16px] sm:text-[18px] leading-tight block w-full truncate"
          style="font-family: 'Be Vietnam Pro', sans-serif;"
        >
          {c.name}
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
