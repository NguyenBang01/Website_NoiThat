---
const collections = [
  {
    title: 'BST MODERN LIVING',
    image: 'https://images.unsplash.com/photo-1618219908412-a29a1bb7b86e?w=800&auto=format&fit=crop&q=80',
    link: '/products?collection=modern-living',
  },
  {
    title: 'BST LUXURY',
    image: 'https://images.unsplash.com/photo-1618219740975-d40978bb7378?w=800&auto=format&fit=crop&q=80',
    link: '/products?collection=luxury',
  },
  {
    title: 'BST MINIMALIST',
    image: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&auto=format&fit=crop&q=80',
    link: '/products?collection=minimalist',
  },
];
---

<section id="bo-suu-tap" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 font-sans">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {collections.map((c) => (
      <a
        href={c.link}
        class="group relative h-[380px] sm:h-[450px] rounded-3xl overflow-hidden shadow-soft hover:shadow-elevated transition-all duration-500 block"
      >
        <!-- Background Dark Ambient Photography -->
        <img
          src={c.image}
          alt={c.title}
          class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-700"
          loading="lazy"
        />

        <!-- Gradient Tint -->
        <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-black/20 group-hover:from-black/90 transition-colors"></div>

        <!-- Center Typography -->
        <div class="absolute inset-0 flex items-center justify-center p-6 text-center">
          <h3 class="font-serif font-black text-2xl sm:text-3xl text-white tracking-widest uppercase drop-shadow-lg group-hover:scale-105 transition-transform duration-300">
            {c.title}
          </h3>
        </div>
      </a>
    ))}
  </div>
</section>
