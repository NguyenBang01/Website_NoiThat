---
/**
 * CollectionsSection.astro
 * Chuẩn thiết kế Figma: BST_02 (Ảnh 1, 2, 3)
 * - Component tổng (Ảnh 1): BST_02
 *   + Flow: Horizontal
 *   + Width: Fixed (1,440px)
 *   + Height: Hug (500px)
 *   + Gap: 4px
 * - Thẻ con (Ảnh 2):
 *   + Flow: Horizontal
 *   + Width: Fill (477.33px)
 *   + Height: Fixed (500px)
 *   + Radius: 8px
 *   + Padding: 24px
 *   + Gap: 10px
 * - Chữ tiêu đề (Ảnh 3):
 *   + Kích thước: 322px (Hug) x 48px (Hug)
 *   + Font: Manrope
 *   + Weight: 800 (ExtraBold)
 *   + Size: 32px
 *   + Line height: 48px
 *   + Letter spacing: 0%
 *   + Text transform: Uppercase
 *   + Color: #FFFFFF
 */

import type { Banner } from '../../types';
import { imgUrl } from '../../lib/format';

export interface Props {
  banners?: Banner[];
}

const { banners = [] } = Astro.props;

const defaultCollections = [
  {
    title: 'BST MODERN LIVING',
    image: 'https://images.unsplash.com/photo-1618219908412-a29a1bb7b86e?w=1200&auto=format&fit=crop&q=85',
    link: '/products?collection=modern-living',
  },
  {
    title: 'BST LUXURY',
    image: 'https://images.unsplash.com/photo-1618219740975-d40978bb7378?w=1200&auto=format&fit=crop&q=85',
    link: '/products?collection=luxury',
  },
  {
    title: 'BST MINIMALIST',
    image: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=1200&auto=format&fit=crop&q=85',
    link: '/products?collection=minimalist',
  },
];

const adminCollections = banners
  .filter((b) => b.is_active !== false && b.position === 'collection')
  .sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));

const collections =
  adminCollections.length > 0
    ? adminCollections.map((b) => ({
        title: b.title,
        image: imgUrl(b.image),
        link: b.link || b.link_url || '/products',
      }))
    : defaultCollections;
---

<section id="bo-suu-tap" class="w-full max-w-[1440px] mx-auto select-none box-border">
  <!-- BST_02: Width 1440px, Height Hug 500px, Gap 4px, Flow Horizontal -->
  <div class="w-full flex flex-col md:flex-row items-center justify-between gap-[4px] box-border">
    {collections.map((c) => (
      <a
        href={c.link}
        class="group relative w-full md:w-[477.33px] md:flex-1 h-[500px] rounded-[8px] overflow-hidden p-[24px] flex items-center justify-center text-center shadow-xs hover:shadow-xl transition-all duration-500 box-border block"
      >
        <!-- Ảnh nền Dark Ambient Photography -->
        <img
          src={c.image}
          alt={c.title}
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 pointer-events-none"
          loading="lazy"
        />

        <!-- Lớp phủ ánh sáng tối làm nổi bật chữ -->
        <div class="absolute inset-0 bg-black/35 group-hover:bg-black/45 transition-colors duration-300 pointer-events-none"></div>

        <!-- Khung chữ tiêu đề chuẩn Figma Ảnh 3: 322px x 48px, Manrope 800, 32px / 48px, #FFFFFF -->
        <div class="relative z-10 w-[322px] max-w-full h-[48px] flex items-center justify-center pointer-events-none">
          <h3
            class="text-[26px] sm:text-[32px] leading-[48px] font-extrabold uppercase text-white tracking-normal drop-shadow-md select-none text-center font-sans m-0 p-0"
            style="font-family: 'Be Vietnam Pro', sans-serif; font-weight: 800;"
          >
            {c.title}
          </h3>
        </div>
      </a>
    ))}
  </div>
</section>
