---
/**
 * PartnersSection.astro
 * Chuẩn thiết kế Figma: ĐỐI TÁC CỦA TÔI (Ảnh 1, 2, 3)
 * - Container tổng (Ảnh 1): Frame 1000003316
 *   + Flow: Vertical
 *   + Width: Fixed (1,280px) (w-full max-w-[1280px] mx-auto)
 *   + Height: Hug (216px)
 *   + Gap: 48px
 * - Tiêu đề (Ảnh 2):
 *   + Kích thước: 1,280px x 48px (Hug), Căn giữa
 *   + Font: Manrope, Weight: 800 (ExtraBold), Size: 32px, Line height: 48px, Tracking: 0%, Case: Uppercase
 *   + Màu chữ: Gradient_Green (#298200 -> #00BF40)
 * - CAROUSEL (Ảnh 3):
 *   + Width: Fill (1,280px), Height: 120px
 *   + Chứa 7 đối tác hiển thị trong các khung bo tròn viền sáng
 */

const partners = [
  {
    name: 'Hexagon Blue',
    type: 'icon',
    color: 'from-blue-500 to-indigo-600',
    iconLetter: 'H',
    sub: 'DESIGN',
  },
  {
    name: 'Hexagon Green',
    type: 'icon',
    color: 'from-emerald-500 to-teal-600',
    iconLetter: 'H',
    sub: 'BUILD',
  },
  {
    name: 'Hexagon Gold',
    type: 'icon',
    color: 'from-amber-400 to-orange-500',
    iconLetter: 'H',
    sub: 'LUXURY',
  },
  {
    name: 'Arch Wood',
    type: 'book',
    color: 'from-emerald-600 to-green-700',
    iconLetter: 'H',
    sub: 'ARCH',
  },
  {
    name: 'Sun Living',
    type: 'sun',
    color: 'from-yellow-400 to-amber-500',
    iconLetter: 'H',
    sub: 'LIVING',
  },
  {
    name: 'HAPPYFOOD',
    type: 'text',
    color: 'text-emerald-700',
    icon: '🌱',
    label: 'HAPPYFOOD',
  },
  {
    name: 'ECOBOOK',
    type: 'text',
    color: 'text-teal-700',
    icon: '📖',
    label: 'ECOBOOK',
  },
];

// Nhân đôi danh sách đối tác để tạo hiệu ứng carousel vô tận mượt mà
const marqueePartners = [...partners, ...partners];
---

<!-- Frame 1000003316: Khung tổng chuẩn Figma Ảnh 1 (1,280px x 216px, Gap 48px, Flow Vertical) -->
<section
  id="doi-tac"
  class="w-full max-w-[1280px] mx-auto min-h-[216px] flex flex-col items-center gap-[48px] font-sans select-none box-border py-4"
>
  <!-- Tiêu đề ĐỐI TÁC CỦA TÔI chuẩn Figma Ảnh 2 (1,280px x 48px, Manrope 800 ExtraBold, 32px / 48px, Gradient_Green #298200 -> #00BF40) -->
  <div class="w-full max-w-[1280px] h-[48px] flex items-center justify-center text-center">
    <h2
      class="text-[28px] sm:text-[32px] leading-[48px] font-extrabold uppercase tracking-normal m-0 p-0 text-center"
      style="font-family: 'Be Vietnam Pro', sans-serif; font-weight: 800; background: linear-gradient(90deg, #298200 0%, #00BF40 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
    >
      ĐỐI TÁC CỦA TÔI
    </h2>
  </div>

  <!-- Component CAROUSEL chuẩn Figma Ảnh 3 (1,280px x 120px) -->
  <div class="relative w-full h-[120px] overflow-hidden flex items-center box-border">
    <!-- Gradient phủ mờ 2 bên viền để logo xuất hiện và lướt qua mượt mà -->
    <div class="absolute left-0 inset-y-0 w-16 bg-gradient-to-r from-white via-white/80 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 inset-y-0 w-16 bg-gradient-to-l from-white via-white/80 to-transparent z-10 pointer-events-none"></div>

    <!-- Hàng logo chuyển động vô tận mượt mà từ phải sang trái -->
    <div class="animate-marquee flex items-center gap-[24px] box-border shrink-0">
      {marqueePartners.map((p, idx) => (
        <div
          class="w-[156px] h-[100px] rounded-[12px] bg-white border border-stone-200/80 shadow-2xs hover:shadow-md flex flex-col items-center justify-center p-3 text-center transition-all duration-300 group shrink-0 select-none hover:scale-105"
        >
          {p.type === 'icon' && (
            <div class="flex flex-col items-center gap-1">
              <div class={`w-11 h-11 rounded-full bg-gradient-to-tr ${p.color} text-white flex items-center justify-center font-black text-xl shadow-xs group-hover:rotate-6 transition-transform`}>
                {p.iconLetter}
              </div>
              <span class="text-[10px] font-bold tracking-widest text-stone-500 uppercase">
                {p.sub}
              </span>
            </div>
          )}

          {p.type === 'book' && (
            <div class="flex flex-col items-center gap-1">
              <div class="w-11 h-11 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-700 flex items-center justify-center font-black text-xl shadow-2xs">
                {p.iconLetter}
              </div>
              <span class="text-[10px] font-bold tracking-widest text-emerald-800 uppercase">
                {p.sub}
              </span>
            </div>
          )}

          {p.type === 'sun' && (
            <div class="flex flex-col items-center gap-1">
              <div class="w-11 h-11 rounded-full bg-amber-50 border border-amber-300 text-amber-600 flex items-center justify-center font-black text-xl shadow-2xs">
                {p.iconLetter}
              </div>
              <span class="text-[10px] font-bold tracking-widest text-amber-700 uppercase">
                {p.sub}
              </span>
            </div>
          )}

          {p.type === 'text' && (
            <div class="flex flex-col items-center gap-1">
              <span class="text-2xl group-hover:scale-110 transition-transform">{p.icon}</span>
              <span class={`font-extrabold text-[12px] tracking-wider uppercase ${p.color}`}>
                {p.label}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
