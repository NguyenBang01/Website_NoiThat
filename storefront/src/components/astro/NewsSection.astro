---
/**
 * NewsSection.astro
 * Chuẩn thiết kế Figma: TIN TỨC (Ảnh 4, 5, 6, 7)
 * - Container tổng (Ảnh 4):
 *   + Flow: Vertical
 *   + Width: Fill (1,440px) (max-w-[1440px] mx-auto)
 *   + Height: Hug (587px)
 *   + Padding: Top 48px, Right 24px, Bottom 48px, Left 24px
 *   + Gap: 48px
 *   + Background: Color/Green/Green10 (#ecfaeb)
 * - Tiêu đề TIN TỨC (Ảnh 5):
 *   + Kích thước: 126px (Hug) x 48px (Hug)
 *   + Font: Manrope
 *   + Weight: 800 (ExtraBold)
 *   + Size: 32px
 *   + Line height: 48px
 *   + Letter spacing: 0%
 *   + Case: Uppercase
 *   + Color: #15803d
 * - Frame 1000002851 (Ảnh 6):
 *   + Flow: Horizontal
 *   + Width: Fixed (1,277px)
 *   + Height: Hug (395px)
 *   + Gap: 24px
 * - Mỗi thẻ bài viết (Ảnh 7):
 *   + Width: Fill (409.67px)
 *   + Height: Fill (395px)
 *   + Radius: 4px
 *   + Border: 1px All sides, Color/Green/Green20 (#b8e6b7)
 *   + Padding: 1px
 *   + Background: #FFFFFF
 */

import type { Banner } from '../../types';
import { imgUrl, formatDate } from '../../lib/format';

export interface Props {
  banners?: Banner[];
}

const { banners = [] } = Astro.props;

const defaultNewsItems = [
  {
    id: 1,
    title: 'Xu Hướng Nội Thất 2026 – Tinh Tế & Bền Vững',
    date: '10/03/2026',
    excerpt: 'Khám phá những phong cách thiết kế nổi bật với vật liệu thân thiện môi trường ...',
    image: 'https://images.unsplash.com/photo-1618219908412-a29a1bb7b86e?w=800&auto=format&fit=crop&q=80',
    link: '/news/xu-huong-noi-that-2026',
  },
  {
    id: 2,
    title: 'Bàn Trà – Điểm Nhấn Hoàn Hảo Cho Phòng Khách',
    date: '23/02/2026',
    excerpt: 'Thiết kế đa dạng, đường nét tinh tế và chất liệu cao cấp giúp hoàn thiện...',
    image: 'https://images.unsplash.com/photo-1533090161767-e6ffed986c88?w=800&auto=format&fit=crop&q=80',
    link: '/news/ban-tra-diem-nhan-phong-khach',
  },
  {
    id: 3,
    title: 'Giải Pháp Nội Thất Văn Phòng Hiện Đại',
    date: '23/02/2026',
    excerpt: 'Tối ưu công năng sử dụng với hệ thống bàn ghế và không gian làm việc hiện đại.',
    image: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&auto=format&fit=crop&q=80',
    link: '/news/giai-phap-noi-that-van-phong',
  },
];

const adminNews = banners
  .filter((b) => b.is_active !== false && b.position === 'news')
  .sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));

const newsItems =
  adminNews.length > 0
    ? adminNews.map((b, idx) => ({
        id: b.id,
        title: b.title,
        date: defaultNewsItems[idx]?.date || formatDate((b as any).created_at) || '10/03/2026',
        excerpt: b.subtitle || defaultNewsItems[idx]?.excerpt || '',
        image: imgUrl(b.image),
        link: b.link || b.link_url || defaultNewsItems[idx]?.link || '/products',
      }))
    : defaultNewsItems;
---

<!-- Khung tổng TIN TỨC chuẩn Figma Ảnh 4 (1440px x 587px, Padding 48px 24px, Gap 48px, Background Green10 #ecfaeb) -->
<section
  id="tin-tuc"
  class="w-full max-w-[1440px] mx-auto min-h-[587px] bg-[#ecfaeb] rounded-[16px] pt-[48px] pb-[48px] px-4 sm:px-[24px] flex flex-col items-center gap-[48px] font-sans select-none box-border"
>
  <!-- Tiêu đề TIN TỨC chuẩn Figma Ảnh 5 -->
  <div class="w-auto min-w-[150px] h-[48px] flex items-center justify-center text-center">
    <h2
      class="text-[32px] leading-[48px] font-extrabold uppercase text-[#15803d] tracking-normal m-0 p-0 text-center font-sans whitespace-nowrap"
      style="font-family: 'Be Vietnam Pro', sans-serif; font-weight: 800;"
    >
      TIN TỨC
    </h2>
  </div>

  <!-- Frame 1000002851: Khung chứa 3 bài viết chuẩn Figma Ảnh 6 (1,277px x 395px, Gap 24px) -->
  <div class="w-full max-w-[1277px] mx-auto flex flex-col md:flex-row items-stretch justify-between gap-[24px] box-border">
    {newsItems.map((item) => (
      <!-- Mỗi thẻ bài viết chuẩn Figma Ảnh 7 (409.67px x 395px, Radius 4px, Border 1px #b8e6b7, Padding 1px, Fill #FFFFFF) -->
      <a
        href={item.link}
        class="group w-full md:w-[409.67px] md:flex-1 h-[395px] bg-white rounded-[4px] border border-[#b8e6b7] overflow-hidden flex flex-col justify-between hover:shadow-lg transition-all duration-300 box-border text-left"
      >
        <!-- Ảnh bài viết -->
        <div class="w-full h-[195px] overflow-hidden bg-stone-100 shrink-0">
          <img
            src={item.image}
            alt={item.title}
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 pointer-events-none"
            loading="lazy"
          />
        </div>

        <!-- Khung nội dung text -->
        <div class="p-[16px] sm:p-[20px] flex-1 flex flex-col justify-between box-border">
          <div class="flex flex-col gap-[6px]">
            <!-- Tiêu đề bài viết -->
            <h3 class="text-[15px] sm:text-[16px] font-bold text-[#15803d] leading-snug line-clamp-2 group-hover:text-[#175214] transition-colors m-0">
              {item.title}
            </h3>

            <!-- Ngày tháng -->
            <p class="text-[12px] text-stone-400 font-medium m-0">
              {item.date}
            </p>

            <!-- Mô tả ngắn -->
            <p class="text-[13px] text-stone-600 line-clamp-2 leading-relaxed m-0 mt-1">
              {item.excerpt}
            </p>
          </div>

          <!-- Mũi tên góc dưới bên phải -->
          <div class="flex justify-end items-center pt-2">
            <span class="text-stone-800 group-hover:text-[#15803d] text-lg leading-none font-bold transition-transform duration-300 group-hover:translate-x-1.5">
              →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
