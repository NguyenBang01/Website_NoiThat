---
import { ArrowRight, ExternalLink } from 'lucide-react';

const newsItems = [
  {
    id: 1,
    title: 'Xu Hướng Nội Thất 2026: Tinh Tế, Bền Vững & Chữa Lành Cho Không Gian Sống',
    date: '10/03/2026',
    source: 'VnExpress Đời Sống',
    excerpt: 'Sự dịch chuyển từ không gian trưng bày cứng nhắc sang trải nghiệm sống có chiều sâu, ấm áp với đường nét uốn lượn và vật liệu tự nhiên.',
    image: 'https://images.unsplash.com/photo-1618219908412-a29a1bb7b86e?w=800&auto=format&fit=crop&q=80',
    link: 'https://vnexpress.net/doi-song/nha-dep',
  },
  {
    id: 2,
    title: 'Bàn Trà & Sofa Phòng Khách – Điểm Nhấn Định Hình Gu Thẩm Mỹ Của Ngôi Nhà',
    date: '28/02/2026',
    source: 'VnExpress Không Gian Sống',
    excerpt: 'Thiết kế bo tròn hữu cơ kết hợp sofa module đệm êm ái đang trở thành lựa chọn hàng đầu của các căn hộ hiện đại.',
    image: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=800&auto=format&fit=crop&q=80',
    link: 'https://vnexpress.net/tag/noi-that-135548',
  },
  {
    id: 3,
    title: 'Giải Pháp Bố Trí Không Gian Nội Thất Tối Giản Ấm Áp Chuẩn Phong Thủy',
    date: '15/02/2026',
    source: 'Tuổi Trẻ Online',
    excerpt: 'Tối ưu hóa ánh sáng tự nhiên và luồng sinh khí với nội thất thông minh, mang lại sự thư thái và năng lượng tích cực cho gia chủ.',
    image: 'https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=800&auto=format&fit=crop&q=80',
    link: 'https://tuoitre.vn/nhip-song-tre.htm',
  },
];
---

<section id="tin-tuc" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 font-sans">
  <div class="rounded-3xl bg-[#e8f7ee] p-6 sm:p-10 border border-[#bbf7d0] shadow-soft space-y-8">
    <div class="text-center space-y-1">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-700">Góc Cảm Hứng & Xu Hướng</span>
      <h2 class="text-2xl sm:text-3xl font-bold font-serif text-brand-900 tracking-tight">
        TIN TỨC & XU HƯỚNG NỘI THẤT
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {newsItems.map((item) => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-2xl overflow-hidden border border-white/80 shadow-soft hover:shadow-elevated transition-all flex flex-col justify-between"
        >
          <div class="aspect-16/10 bg-warm-100 overflow-hidden relative">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <span class="absolute top-3 right-3 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-[10px] font-semibold text-brand-800 shadow-2xs">
              {item.source}
            </span>
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
            <div class="space-y-1.5">
              <h3 class="font-bold text-sm text-brand-900 group-hover:text-brand-700 transition line-clamp-2 leading-snug">
                {item.title}
              </h3>
              <p class="text-[11px] text-warm-400 font-medium">{item.date}</p>
              <p class="text-xs text-warm-600 line-clamp-2 leading-relaxed">
                {item.excerpt}
              </p>
            </div>

            <div class="pt-2 flex items-center justify-between text-xs font-medium text-brand-700 group-hover:text-brand-800 border-t border-warm-100">
              <span class="inline-flex items-center gap-1">Đọc trên {item.source} <ExternalLink class="w-3 h-3" /></span>
              <div class="group-hover:translate-x-1 transition-transform">
                <ArrowRight class="w-4 h-4" />
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
