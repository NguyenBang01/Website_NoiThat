---
---

<footer class="w-full bg-[#f4fbf6] border-t border-[#dcfce7] pt-14 pb-10 font-sans relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Left Column: Brand & Line Art (Cols 1-4) -->
      <div class="md:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-brand-700 text-white flex items-center justify-center font-serif font-black text-lg shadow-xs">
            G
          </div>
          <span class="font-serif font-bold text-2xl text-brand-900 tracking-tight">
            GÓC NHÀ ĐẸP
          </span>
        </a>

        <p class="text-xs sm:text-sm text-warm-600 leading-relaxed italic pr-4">
          Thương hiệu nội thất phong cách hiện đại tối giản. Đồng hành kiến tạo không gian tiện ích tối ưu và phong thái thẩm mỹ sang trọng bậc nhất cho ngôi nhà Việt.
        </p>

        <!-- Line Art Sofa Illustration SVG -->
        <div class="pt-2 opacity-75">
          <svg class="w-48 h-auto text-warm-400 stroke-current fill-none stroke-[1.2]" viewBox="0 0 160 50">
            <!-- Sofa back and cushion -->
            <path d="M20 38 C20 28, 25 20, 40 20 L110 20 C125 20, 130 28, 130 38" />
            <path d="M15 38 L135 38 C138 38, 140 40, 140 43 L10 43 C10 40, 12 38, 15 38 Z" />
            <line x1="20" y1="43" x2="18" y2="48" stroke-width="2" />
            <line x1="130" y1="43" x2="132" y2="48" stroke-width="2" />
            <line x1="75" y1="20" x2="75" y2="38" />
            <!-- Pillows -->
            <rect x="25" y="24" width="22" height="12" rx="3" stroke-width="1" />
            <rect x="103" y="24" width="22" height="12" rx="3" stroke-width="1" />
            <!-- Standing Lamp -->
            <line x1="148" y1="48" x2="148" y2="10" stroke-width="1.2" />
            <polygon points="144,14 152,14 154,6 142,6" stroke-width="1.2" />
            <circle cx="148" cy="48" r="4" stroke-width="1" />
          </svg>
        </div>
      </div>

      <!-- Middle Column: Showrooms & Hotline (Cols 5-8) -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="font-bold text-base text-warm-900 tracking-tight">
          Văn Phòng & Showroom
        </h4>

        <div class="space-y-3.5 text-xs sm:text-sm text-warm-700 leading-relaxed">
          <div>
            <strong class="font-semibold text-brand-900 block mb-0.5">Showroom 1:</strong>
            <p class="text-warm-600">615 Âu Cơ, Phường Phú Trung, Quận Tân Phú, TP. HCM</p>
          </div>

          <div>
            <strong class="font-semibold text-brand-900 block mb-0.5">Showroom 2:</strong>
            <p class="text-warm-600">295 Tây Thạnh, Phường Tây Thạnh, Quận Tân Phú, TP. HCM</p>
          </div>

          <div class="pt-2">
            <span class="text-xs text-warm-500 block">Hotline tư vấn thiết kế:</span>
            <a href="tel:0931883988" class="font-bold text-brand-700 text-base hover:underline">
              0931.883.988
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Arched Image & Social Icons (Cols 9-12) -->
      <div class="md:col-span-4 flex flex-col items-center md:items-end space-y-4">
        <!-- Arched Cozy Corner Photo Card -->
        <div class="relative w-64 h-44 rounded-t-full rounded-b-2xl overflow-hidden border-2 border-emerald-200/80 shadow-soft bg-white">
          <img
            src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=500&auto=format&fit=crop&q=80"
            alt="Góc Nhà Đẹp"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent flex flex-col justify-end p-4 text-white text-center">
            <span class="font-serif italic text-xs tracking-wide">Mỗi không gian</span>
            <span class="font-serif font-bold text-sm tracking-tight text-brand-200">Một câu chuyện</span>
          </div>
        </div>

        <!-- Social Icons Row: Google, Facebook, Zalo, TikTok -->
        <div class="flex items-center gap-2.5 pt-1">
          <!-- Google -->
          <a
            href="https://google.com"
            target="_blank"
            rel="noopener noreferrer"
            title="Google"
            class="w-9 h-9 rounded-full bg-white shadow-xs border border-warm-200 flex items-center justify-center text-warm-700 hover:text-brand-700 hover:scale-105 transition"
          >
            <span class="font-bold font-sans text-xs">G</span>
          </a>

          <!-- Facebook -->
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            title="Facebook"
            class="w-9 h-9 rounded-full bg-white shadow-xs border border-warm-200 flex items-center justify-center text-blue-600 hover:scale-105 transition font-bold text-xs"
          >
            f
          </a>

          <!-- Zalo -->
          <a
            href="https://zalo.me/0931883988"
            target="_blank"
            rel="noopener noreferrer"
            title="Zalo"
            class="w-9 h-9 rounded-full bg-white shadow-xs border border-warm-200 flex items-center justify-center text-blue-500 hover:scale-105 transition font-bold text-[10px]"
          >
            Zalo
          </a>

          <!-- TikTok -->
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            title="TikTok"
            class="w-9 h-9 rounded-full bg-white shadow-xs border border-warm-200 flex items-center justify-center text-warm-900 hover:scale-105 transition"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-10 mt-8 border-t border-emerald-200/60 flex flex-col sm:flex-row items-center justify-between text-xs text-warm-500 gap-3">
      <p>© 2026 Góc Nhà Đẹp. Tất cả các quyền được bảo lưu.</p>
      <div class="flex items-center gap-6">
        <a href="/contact" class="hover:text-brand-700 transition">Liên hệ Showroom</a>
        <a href="#" class="hover:text-brand-700 transition">Chính sách bảo hành</a>
        <a href="#" class="hover:text-brand-700 transition">Chính sách bảo mật</a>
        <a href="#" class="hover:text-brand-700 transition">Điều khoản dịch vụ</a>
      </div>
    </div>
  </div>
</footer>
