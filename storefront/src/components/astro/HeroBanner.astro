---
---

<section class="relative w-full h-[540px] sm:h-[600px] lg:h-[660px] bg-warm-900 overflow-hidden font-sans">
  <!-- Background Image with Ambient Overlay -->
  <img
    src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1920&auto=format&fit=crop&q=85"
    alt="Góc Nhà Đẹp - Không gian sống tinh tế"
    class="absolute inset-0 w-full h-full object-cover object-center scale-102"
    loading="eager"
  />

  <!-- Gradient Overlay matching Figma tone -->
  <div class="absolute inset-0 bg-linear-to-r from-black/75 via-black/40 to-transparent"></div>
  <div class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent"></div>

  <!-- Hero Content Box -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center">
    <div class="max-w-2xl space-y-5 text-white">
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-serif tracking-tight leading-tight uppercase">
          MỖI KHÔNG GIAN
          <span class="block text-brand-200">MỘT CÂU CHUYỆN RIÊNG</span>
        </h1>
      </div>

      <p class="text-warm-100 text-sm sm:text-base lg:text-lg leading-relaxed italic font-light max-w-xl">
        Kiến tạo không gian sống tinh tế với những giải pháp nội thất hiện đại, hài hòa giữa thẩm mỹ, công năng và cảm hứng sống.
      </p>

      <div class="pt-3">
        <a
          href="/products"
          class="inline-flex items-center gap-2 text-white font-semibold text-sm sm:text-base hover:text-brand-300 transition group border-b-2 border-white hover:border-brand-300 pb-1"
        >
          <span>Khám phá ngay</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
