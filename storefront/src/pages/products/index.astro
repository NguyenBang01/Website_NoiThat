---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
import FloatingContactWidget from '../../components/react/FloatingContactWidget';
import RoomShowroomSection from '../../components/react/RoomShowroomSection';
import { fetchProducts, fetchCategories, fetchBrands } from '../../lib/api';

// Lấy tham số category và q từ URL trên Server (SSR)
const categoryParam = Astro.url.searchParams.get('category') || '';
const queryParam = Astro.url.searchParams.get('q') || '';

// Fetch danh sách sản phẩm khớp với bộ lọc category / query từ backend
let { products } = await fetchProducts({
  limit: 100,
  category: categoryParam || undefined,
  q: queryParam || undefined,
});

// Nếu không có sản phẩm nào khớp với bộ lọc cụ thể (ví dụ nhập slug lạ), tải danh sách sản phẩm chung để trang không bị rỗng
if (!products || products.length === 0) {
  const all = await fetchProducts({ limit: 100 });
  products = all.products || [];
}
const categories = await fetchCategories();
const brands = await fetchBrands();
---

<BaseLayout
  title={categoryParam ? "Sản Phẩm - Góc Nhà Đẹp" : "Tất Cả Sản Phẩm - Góc Nhà Đẹp"}
  description="Khám phá trọn bộ sưu tập nội thất cao cấp Góc Nhà Đẹp: sofa da, bàn ghế, giường ngủ, bàn làm việc, tủ kệ, đèn trang trí."
>
  <Header slot="header" />

  {/* Phần hiển thị danh mục và bộ lọc sản phẩm */}
  <div class="py-6">
    <RoomShowroomSection
      client:load
      products={products}
      categories={categories}
      brands={brands}
      initialCategory={categoryParam}
      initialQuery={queryParam}
      maxItems={0}
    />
  </div>

  <Footer slot="footer" />
  <FloatingContactWidget client:load />
</BaseLayout>
