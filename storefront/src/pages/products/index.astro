---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
import CartDrawer from '../../components/react/CartDrawer';
import FloatingContactWidget from '../../components/react/FloatingContactWidget';
import RoomShowroomSection from '../../components/react/RoomShowroomSection';
import { fetchProducts, fetchCategories } from '../../lib/api';

// Lấy tham số category và q từ URL trên Server (SSR)
const categoryParam = Astro.url.searchParams.get('category') || '';
const queryParam = Astro.url.searchParams.get('q') || '';

const { products } = await fetchProducts({ limit: 100 });
const categories = await fetchCategories();
---

<BaseLayout
  title={categoryParam ? "Sản Phẩm - Góc Nhà Đẹp" : "Tất Cả Sản Phẩm - Góc Nhà Đẹp"}
  description="Khám phá trọn bộ sưu tập nội thất cao cấp Góc Nhà Đẹp: sofa da, bàn ghế, giường ngủ, bàn làm việc, tủ kệ, đèn trang trí."
>
  <Header slot="header" />

  {/* Phần hiển thị danh mục và bộ lọc sản phẩm */}
  <div class="py-6">
    <RoomShowroomSection
      client:load
      products={products}
      categories={categories}
      initialCategory={categoryParam}
      initialQuery={queryParam}
    />
  </div>

  <Footer slot="footer" />
  <CartDrawer client:load />
  <FloatingContactWidget client:load />
</BaseLayout>
