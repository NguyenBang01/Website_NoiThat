---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import CartDrawer from '../components/react/CartDrawer';
import FloatingContactWidget from '../components/react/FloatingContactWidget';
import UnifiedLoginPage from '../components/react/UnifiedLoginPage';
---

<BaseLayout
  title="Đăng Nhập & Đăng Ký - Góc Nhà Đẹp | Nội Thất Sang Trọng & Tinh Tế"
  description="Đăng nhập hoặc đăng ký tài khoản thành viên Góc Nhà Đẹp để theo dõi đơn hàng, quản lý sản phẩm yêu thích và nhận ưu đãi độc quyền."
>
  <Header slot="header" />

  <main class="min-h-[85vh] bg-gradient-to-b from-warm-50 via-[#f8f7f5] to-warm-100/60 py-8 sm:py-14 px-4 sm:px-6 lg:px-8 flex items-center justify-center">
    <UnifiedLoginPage client:load />
  </main>

  <Footer slot="footer" />
  <CartDrawer client:load />
  <FloatingContactWidget client:load />
</BaseLayout>
