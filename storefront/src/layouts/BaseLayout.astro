---
import Seo from '../components/astro/Seo.astro';
import ClientInitializer from '../components/react/ClientInitializer';
import ToasterWrapper from '../components/react/ToasterWrapper';
import AuthModal from '../components/react/AuthModal';
import CartDrawer from '../components/react/CartDrawer';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
}

const { title, description, image, canonical, type } = Astro.props;
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
    />
    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <!-- Google Identity Services SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-warm-50 text-warm-900 font-sans antialiased selection:bg-brand-100 selection:text-brand-900 flex flex-col">
    <!-- Client Island Initializer -->
    <ClientInitializer client:load />
    <ToasterWrapper client:load />

    <slot name="header" />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Global Auth Popup Modal (Đăng nhập / Đăng ký) -->
    <AuthModal client:load />
    <!-- Global Sliding Cart Drawer (Giỏ hàng nhanh - luôn hiển thị trên cùng không bị thanh menu che) -->
    <CartDrawer client:load />
  </body>
</html>

